    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev --turbo --hostname localhost --port 1147",
    "dev:clean": "node scripts/clear-dev-cookies.js",
    "dev:simple": "next dev --turbo --hostname localhost --port 1147",
    "dev:multi": "next dev --turbo --hostname ${APP_HOST:-localhost} --port ${PORT:-1147}",
    "build": "next build",
    "start": "node scripts/start-server.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "test": "pnpm test:unit",
    "test:unit": "tsx --test lib/ai/models.node.test.ts",
    "test:e2e": "AUTH_SECRET=playwright-local-placeholder-secret-32bytes AUTH_ORIGIN=http://localhost:1147 NEXT_PUBLIC_PLATFORM_URL=http://localhost:1147 NEXT_PUBLIC_API_BASE_URL= NEXT_PUBLIC_TEE_ENCLAVE_URL= PRIVATE_API_BASE_URL= PRIVATE_MPP_API_BASE_URL= PRIVATE_TEE_ENCLAVE_URL= NEXT_PUBLIC_MCP_URL=https://mcp.example.com/mcp NEXT_PUBLIC_THIRDWEB_CLIENT_ID=example-client-id THIRDWEB_SECRET_KEY= NEXT_PUBLIC_ENABLE_ANALYTICS=0 PLAYWRIGHT=True PORT=1147 playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "analyze": "ANALYZE=true pnpm build",
    "benchmark:routes": "node scripts/benchmark-routes.mjs",
    "bundle-size": "pnpm build && node scripts/check-bundle-size.mjs"
  },
