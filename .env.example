# Copy this file to .env.local. Never put real credentials in this example file.

# Public application and API origins. These local defaults do not contact a hosted service.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:1147
NEXT_PUBLIC_SITE_URL=http://localhost:1147
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_TEE_ENCLAVE_URL=http://localhost:5000
NEXT_PUBLIC_MCP_URL=https://mcp.example.com/mcp

# Server-only upstreams used by same-origin proxy routes
PRIVATE_API_BASE_URL=http://localhost:5000
PRIVATE_MPP_API_BASE_URL=http://localhost:5000
PRIVATE_TEE_ENCLAVE_URL=http://localhost:5000

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_ORIGIN=http://localhost:1147
# Leave empty for host-only cookies. Only set this when every intended host is trusted.
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# Optional legacy database routes and migrations
POSTGRES_URL=

# Optional Stripe surfaces
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional World App sign-in
WORLD_ID_APP_ID=
WORLD_ID_ACTION=
WORLDCOIN_SECRET=

# Optional feature and diagnostics flags
NEXT_PUBLIC_ENABLE_ANALYTICS=0
AUTH_DEBUG=0
NEXT_PUBLIC_AUTH_DEBUG=0
NEXT_PUBLIC_PII_DEBUG=0
NEXT_PUBLIC_PII_DEBUG_VERBOSE=0
NEXT_PUBLIC_DISABLE_STRIPE_LOGS=1
